{
  "name": "aptispace-lms",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wireit",
    "dev": "wireit",
    "lint": "wireit",
    "test": "wireit",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "wireit",
    "db:generate": "wireit",
    "db:migrate:local": "wireit",
    "db:migrate:remote": "wrangler d1 migrations apply aptispace-lms-db --remote",
    "db:seed:local": "wireit",
    "db:reset:local": "wireit",
    "db:setup:local": "wireit",
    "typegen:cf": "wrangler types",
    "deploy": "wrangler deploy",
    "prepare": "husky"
  },
  "wireit": {
    "db:generate": {
      "command": "drizzle-kit generate",
      "files": [
        "app/db/schema.ts",
        "drizzle.config.ts"
      ],
      "output": [
        "drizzle/migrations/**/*"
      ]
    },
    "db:migrate:local": {
      "command": "wrangler d1 migrations apply aptispace-lms-db --local",
      "env": {
        "CI": "true"
      },
      "files": [
        "drizzle/migrations/**/*",
        "wrangler.jsonc"
      ],
      "output": []
    },
    "db:seed:local": {
      "command": "tsx scripts/seed-local.ts",
      "dependencies": [
        "db:migrate:local"
      ],
      "files": [
        "scripts/seed-local.ts",
        "app/db/**/*",
        "wrangler.jsonc"
      ],
      "output": []
    },
    "db:reset:local": {
      "command": "tsx scripts/reset-local.ts",
      "dependencies": [
        "db:migrate:local"
      ],
      "files": [
        "scripts/reset-local.ts",
        "app/db/**/*",
        "wrangler.jsonc"
      ],
      "output": []
    },
    "db:setup:local": {
      "dependencies": [
        "db:generate",
        "db:migrate:local",
        "db:seed:local"
      ]
    },
    "test": {
      "command": "vitest run",
      "files": [
        "app/**/*",
        "test/**/*",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "output": []
    },
    "storybook": {
      "command": "storybook dev -p 6006 --ci",
      "service": true,
      "env": {
        "STORYBOOK_DISABLE_TELEMETRY": "1",
        "NODE_OPTIONS": "--no-deprecation"
      }
    },
    "build-storybook": {
      "command": "storybook build --test",
      "env": {
        "STORYBOOK_DISABLE_TELEMETRY": "1",
        "NODE_OPTIONS": "--no-deprecation"
      },
      "files": [
        ".storybook/**/*",
        "app/**/*",
        "package.json",
        "tsconfig.json"
      ],
      "output": [
        "storybook-static/**/*"
      ]
    },
    "lint": {
      "command": "eslint . && prettier . --write",
      "files": [
        "app/**/*",
        "eslint.config.js",
        "package.json",
        "tsconfig.json"
      ],
      "output": []
    },
    "typecheck": {
      "command": "react-router typegen && tsc",
      "files": [
        "app/**/*",
        "tsconfig.json",
        "react-router.config.ts",
        "vite.config.ts"
      ],
      "output": []
    },
    "build": {
      "command": "react-router build",
      "dependencies": [
        "typecheck",
        "lint",
        "test"
      ],
      "files": [
        "app/**/*",
        "public/**/*",
        "package.json",
        "tsconfig.json",
        "react-router.config.ts",
        "vite.config.ts"
      ],
      "output": [
        "build/**/*",
        ".react-router/**/*"
      ]
    },
    "dev": {
      "command": "react-router dev",
      "service": true,
      "dependencies": [
        "db:migrate:local"
      ],
      "env": {
        "NODE_OPTIONS": "--max-http-header-size=65536"
      }
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.1.1",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "isbot": "^5.1.36",
    "material-shapes-ts": "^0.3.0",
    "octokit": "^5.0.5",
    "ogl": "^1.0.11",
    "react": "^19.2.7",
    "react-card-flip": "^1.2.3",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.12",
    "react-material-expressive": "^1.1.2",
    "react-router": "^8",
    "sonner": "^2.0.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "playwright": "latest",
    "prettier": "^3.9.6",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.11",
    "wireit": "^0.14.13",
    "wrangler": "^4.126.0"
  }
}
