{
  "name": "aptispace-lms",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wireit",
    "dev": "wireit",
    "lint": "wireit",
    "test": "wireit",
    "test:unit": "wireit",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "wireit",
    "db:generate": "wireit",
    "db:migrate:local": "wireit",
    "db:migrate:remote": "wrangler d1 migrations apply aptispace-lms-db --remote",
    "db:seed:local": "wireit",
    "db:reset:local": "wireit",
    "db:setup:local": "wireit",
    "typegen:cf": "wrangler types",
    "deploy": "wrangler deploy",
    "prepare": "husky",
    "test:coverage": "wireit",
    "sonar": "wireit",
    "sonar:server": "docker compose -f docker-compose.sonar.yml up -d",
    "sonar:down": "docker compose -f docker-compose.sonar.yml down",
    "knip": "wireit",
    "knip:fix": "knip --fix --allow-remove-files",
    "test:e2e": "wireit",
    "test:e2e:ui": "playwright test --ui"
  },
  "wireit": {
    "db:generate": {
      "command": "drizzle-kit generate",
      "clean": false,
      "files": [
        "app/db/schema.ts",
        "drizzle.config.ts"
      ],
      "output": [
        "drizzle/migrations/**/*"
      ]
    },
    "db:migrate:local": {
      "command": "wrangler d1 migrations apply aptispace-lms-db --local",
      "env": {
        "CI": "true"
      },
      "files": [
        "drizzle/migrations/**/*",
        "wrangler.jsonc"
      ],
      "output": []
    },
    "db:seed:local": {
      "command": "tsx scripts/seed-local.ts",
      "dependencies": [
        "db:migrate:local"
      ],
      "files": [
        "scripts/seed-local.ts",
        "app/db/**/*",
        "wrangler.jsonc"
      ],
      "output": []
    },
    "db:reset:local": {
      "command": "tsx scripts/reset-local.ts",
      "dependencies": [
        "db:migrate:local"
      ],
      "files": [
        "scripts/reset-local.ts",
        "app/db/**/*",
        "wrangler.jsonc"
      ],
      "output": []
    },
    "db:setup:local": {
      "dependencies": [
        "db:generate",
        "db:migrate:local",
        "db:seed:local"
      ]
    },
    "test:unit": {
      "command": "vitest run",
      "env": {
        "NODE_OPTIONS": "--no-deprecation"
      },
      "files": [
        "app/**/*",
        "test/**/*",
        "stories/**/*",
        ".storybook/**/*",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "output": []
    },
    "test:e2e": {
      "command": "playwright test",
      "dependencies": [
        "db:setup:local"
      ],
      "env": {
        "NODE_OPTIONS": "--no-deprecation"
      },
      "files": [
        "playwright/**/*",
        "playwright.config.ts",
        "app/**/*",
        "package.json",
        "tsconfig.json"
      ],
      "output": [
        "playwright-report/**/*",
        "test-results/**/*"
      ]
    },
    "test": {
      "dependencies": [
        "test:unit",
        "test:e2e"
      ]
    },
    "test:coverage": {
      "command": "vitest run --coverage --project components --project server-and-utils",
      "env": {
        "NODE_OPTIONS": "--no-deprecation"
      },
      "files": [
        "app/**/*",
        "test/**/*",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "coverage/**/*"
      ]
    },
    "storybook": {
      "command": "storybook dev -p 6006 --ci",
      "service": true,
      "env": {
        "STORYBOOK_DISABLE_TELEMETRY": "1",
        "NODE_OPTIONS": "--no-deprecation"
      }
    },
    "build-storybook": {
      "command": "storybook build --test",
      "env": {
        "STORYBOOK_DISABLE_TELEMETRY": "1",
        "NODE_OPTIONS": "--no-deprecation"
      },
      "files": [
        ".storybook/**/*",
        "app/**/*",
        "stories/**/*",
        "package.json",
        "tsconfig.json"
      ],
      "output": [
        "storybook-static/**/*"
      ]
    },
    "lint": {
      "command": "eslint . && prettier . --write",
      "files": [
        "app/**/*",
        ".storybook/**/*",
        "stories/**/*",
        "eslint.config.js",
        "package.json",
        "tsconfig.json"
      ],
      "output": []
    },
    "typecheck": {
      "command": "react-router typegen && tsc",
      "files": [
        "app/**/*",
        "tsconfig.json",
        "react-router.config.ts",
        "vite.config.ts"
      ],
      "output": [
        ".react-router/types/**/*"
      ]
    },
    "build": {
      "command": "react-router build",
      "dependencies": [
        "typecheck",
        "lint",
        "test"
      ],
      "files": [
        "app/**/*",
        "public/**/*",
        "package.json",
        "tsconfig.json",
        "react-router.config.ts",
        "vite.config.ts"
      ],
      "output": [
        "build/**/*",
        ".react-router/**/*"
      ]
    },
    "dev": {
      "command": "react-router dev",
      "service": true,
      "dependencies": [
        "db:migrate:local"
      ],
      "env": {
        "NODE_OPTIONS": "--max-http-header-size=65536"
      }
    },
    "sonar": {
      "command": "node scripts/sonar-scan.mjs",
      "dependencies": [
        "test:coverage",
        "lint",
        "typecheck"
      ],
      "files": [
        "sonar-project.properties",
        "scripts/sonar-scan.mjs",
        "app/**/*",
        "coverage/lcov.info"
      ],
      "output": [
        ".scannerwork/**/*"
      ]
    },
    "knip": {
      "command": "knip",
      "dependencies": [
        "typecheck"
      ],
      "files": [
        "app/**/*",
        "stories/**/*",
        "scripts/**/*",
        "knip.json",
        "package.json",
        "tsconfig.json"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-data-grid": "^9.13.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@mui/x-scheduler": "9.0.0-beta.11",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.2.0",
    "i18next": "^26.4.2",
    "ical-generator": "^11.1.1",
    "isbot": "^5.2.2",
    "material-shapes-ts": "^0.3.0",
    "octokit": "^5.0.5",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-material-expressive": "^1.1.2",
    "react-router": "^8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8",
    "@sonar/scan": "^5.0.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "playwright": "latest",
    "prettier": "^3.9.6",
    "storybook": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wireit": "^0.14.13",
    "wrangler": "^4.129.0"
  }
}
